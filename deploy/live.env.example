# /etc/cricket/live.env  (chmod 600, root only)
# Copy to /etc/cricket/live.env on the server and fill in real values.

# Telegram bot (create via @BotFather in Telegram)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF-your-token-here
TELEGRAM_CHAT_ID=123456789

# Anthropic vision API key (for reading Betfair screenshots)
# Get from https://console.anthropic.com -> API keys
ANTHROPIC_API_KEY=sk-ant-...
